{
  "name": "pixels",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "start": "astro dev",
    "build": "tinacms build --skip-cloud-checks --skip-search-index && astro build",
    "build:prod": "bun install && bun run build",
    "build:dev": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "f": "(git diff --name-only --diff-filter=ACMR HEAD && git ls-files --others --exclude-standard) | xargs bunx prettier --write --ignore-unknown",
    "f:all": "prettier --write .",
    "f:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "types": "tsc --noEmit",
    "check": "bun run lint && bun run types",
    "prepare": "test -d .git && husky || true",
    "postinstall": "astro telemetry disable",
    "bs": "scripts/bootstrap.sh",
    "upd": "apt update && apt upgrade -y && bun upgrade && bun update --latest && bun f"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/cli": "^2.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.0",
    "astro-seo": "^1.1.0",
    "gsap": "^3.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.0",
    "tailwindcss": "^4.3.0",
    "tinacms": "^3.8.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^2.0.0",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3"
  }
}
